{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFCraft",
  "version": "0.1.0",
  "identifier": "com.pdfcraft.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDFCraft",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "publisher": "PDFCraft",
    "shortDescription": "Private PDF reader and editor",
    "longDescription": "Open, edit, merge, split, compress, sign and watermark PDF files locally on your computer.",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
